{
  "name": "redsound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c red,gray \"vite --port 5173\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/bundle-api.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test server/domain/rights.test.ts server/domain/arrange.test.ts server/suno/generate.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
