# Server-only. Never expose this to the browser.
SUNO_API_KEY=
SUNO_API_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V6

# Public origin. Suno callbacks and Redface Pay return here.
# After the Cloudflare domain is on Vercel, set this to https://your-domain
# with no trailing slash. Leave empty in local dev.
PUBLIC_BASE_URL=

# Redface Pay commerce key (rf_live_…). Server only. Never send this to the browser.
# Create it in the Redface Pay merchant portal. Checkout uses the existing Paystack plans.
REDFACE_API_KEY=
REDFACE_BUSINESS_ID=
REDFACE_COMMERCE_API_BASE=https://bpzzgilwlkghgfkvkkxx.supabase.co/functions/v1/commerce-api

PORT=8787

# Live checkout stays off until creator terms are counsel-reviewed.
# Both must be set, and the terms version must not be "draft".
MARKETPLACE_ENABLED=false
CREATOR_TERMS_VERSION=draft

# Platform commission in basis points. 1000 = 10%.
PLATFORM_FEE_BPS=1000

# Supabase. Publishable key may be exposed to the browser. Never commit the secret key.
SUPABASE_URL=https://bpzzgilwlkghgfkvkkxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://bpzzgilwlkghgfkvkkxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
